# ПИНОК — переменные окружения.
#
# Как пользоваться:
#   1. Скопируй этот файл:  cp .env.example .env.local
#   2. Впиши ключи в .env.local (этот файл в .gitignore и никогда не попадает в git).
#   3. Ключ без значения = приложение работает на заглушке (mock) и не тратит деньги.
#
# ПРАВИЛО: переменные БЕЗ префикса NEXT_PUBLIC_ видит только сервер.
# Переменные С префиксом NEXT_PUBLIC_ попадают в браузер — туда кладём только то,
# что безопасно показывать всем (публичные ключи, адреса).

# --- Anthropic (чат с тренерами) -------------------------------------------
# Откуда: https://console.anthropic.com → API Keys. Только сервер.
# Платный аккаунт — на родителя. Без ключа чат отвечает заготовленными фразами.
ANTHROPIC_API_KEY=
# Какая модель отвечает в чате. Пусто = claude-haiku-5-5 (самая дешёвая из актуальных).
# Цена ответа — доли цента; лимит 60 ответов в день на человека, дальше тренер отвечает заготовками.
ANTHROPIC_CHAT_MODEL=

# --- ElevenLabs (голос тренеров) -------------------------------------------
# Откуда: https://elevenlabs.io → Profile → API Keys. Только сервер.
# Без ключа голос идёт через встроенный в браузер синтезатор (Web Speech Synthesis).
ELEVENLABS_API_KEY=

# --- Supabase (база данных, вход, файлы) -----------------------------------
# Откуда: https://supabase.com → проект → Project Settings → API.
# URL и anon-ключ публичные по задумке (данные защищает Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role обходит защиту RLS — ТОЛЬКО сервер, никогда не в браузер и не в git.
SUPABASE_SERVICE_ROLE_KEY=

# --- Web Push (уведомления) ------------------------------------------------
# Сгенерировать пару ключей: pnpm dlx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контакт владельца для push-сервисов, формат: mailto:you@example.com
VAPID_SUBJECT=

# --- PostHog (аналитика, бесплатный тариф) ---------------------------------
# Откуда: https://posthog.com → Project Settings → Project API Key (публичный).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Админка владельца -----------------------------------------------------
# Email, которому разрешён вход на /admin/costs.
ADMIN_EMAIL=
