# ПИНОК — переменные окружения.
#
# Как пользоваться:
#   1. Скопируй этот файл:  cp .env.example .env.local
#   2. Впиши ключи в .env.local (этот файл в .gitignore и никогда не попадает в git).
#   3. ВСЁ НИЖЕ НЕОБЯЗАТЕЛЬНО. Без ключей приложение полностью работает:
#      тренеры отвечают заготовками, голос — встроенный в браузер, уведомления — только пока
#      приложение открыто. Каждый ключ просто делает какую-то часть лучше.
#
# ПРАВИЛО: переменные БЕЗ префикса NEXT_PUBLIC_ видит только сервер.
# Переменные С префиксом NEXT_PUBLIC_ попадают в браузер — туда кладём только то,
# что безопасно показывать всем (публичные ключи).

# --- Anthropic (умные ответы тренеров в чате) ------------------------------
# Откуда: https://console.anthropic.com → API Keys. Только сервер.
# Платный сервис — заводить на родителя. Без ключа тренеры отвечают заготовленными фразами.
ANTHROPIC_API_KEY=
# Какая модель отвечает в чате. Пусто = claude-haiku-5-5 (самая дешёвая из актуальных).
# Цена ответа — доли цента; лимит 60 ответов в день на человека, дальше тренер отвечает заготовками.
ANTHROPIC_CHAT_MODEL=

# --- ElevenLabs (настоящий голос тренеров) ---------------------------------
# Откуда: https://elevenlabs.io → Profile → API Keys. Только сервер.
# Без ключа голос идёт через встроенный в браузер синтезатор (бесплатно, но звучит «роботом»).
ELEVENLABS_API_KEY=
# Если хочешь другой голос тренера — впиши его ID (взять в ElevenLabs → Voices). Пусто = по умолчанию.
ELEVENLABS_VOICE_GROMOV=
ELEVENLABS_VOICE_MARINA=
ELEVENLABS_VOICE_PALYCH=
ELEVENLABS_VOICE_MAX=

# --- Web Push (уведомления, когда приложение закрыто) ----------------------
# Сгенерировать пару ключей: pnpm dlx web-push generate-vapid-keys
# Публичный ключ можно показывать, приватный — НИКОГДА.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контакт владельца для push-сервисов, формат: mailto:you@example.com
VAPID_SUBJECT=
# Секрет для /api/push/tick (его раз в минуту вызывает планировщик, например cron-job.org).
# Придумай любую длинную строку. Без секрета отправка разрешена только при pnpm dev.
CRON_SECRET=

# --- Админка владельца -----------------------------------------------------
# Страница расходов: /admin/costs?token=<это значение>. Придумай длинную случайную строку.
# Без ADMIN_TOKEN страница открыта только при локальной разработке (pnpm dev).
ADMIN_TOKEN=

# --- Потолок трат ----------------------------------------------------------
# Сколько долларов в день (по оценке) сервер готов потратить на платные вызовы суммарно.
# Дальше тренеры отвечают заготовками, а голос — браузерный. Пусто = 3.
DAILY_BUDGET_USD=
# Ещё надёжнее: поставь лимит расходов прямо в кабинетах Anthropic и ElevenLabs.

# --- Оценка расходов (необязательно) ---------------------------------------
# Цены меняются; эти числа нужны только для страницы /admin/costs. Доллары за миллион токенов.
# COST_LLM_INPUT_PER_MTOK=0.1
# COST_LLM_OUTPUT_PER_MTOK=0.5
# Доллары за 1000 символов озвучки.
# COST_TTS_PER_1K_CHARS=0.12
